# Copy to deploy/.env and change every secret.
OGE_API_KEY=change-me-long-random-string
NEO4J_PASSWORD=change-me-please

# CPU profile (laptop: 16 GB RAM, 8+ cores)
LLM_CTX_TOTAL=16384
LLM_PARALLEL=2
LLM_THREADS=8

# Pin images by digest for production (docker inspect --format '{{index .RepoDigests 0}}' <image>)
# LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server@sha256:...
# LLAMACPP_CUDA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:...
# VLLM_IMAGE=vllm/vllm-openai:v0.27.1
# NEO4J_IMAGE=neo4j:5.26-community

# Use Neo4j as the graph backend of the MCP server (requires --profile neo4j)
OGE_MCP_NEO4J=0

# Dense (semantic) retrieval in the MCP server, served by the embeddings container (opt-in; slow first start)
# OGE_MCP_EMBEDDER=openai:http://embeddings:8081|qwen3-embedding

# Jenkins (deploy/compose.ci.yaml): admin account and the agent's service account (Job/Build + Read only)
JENKINS_ADMIN_PASSWORD=change-me-admin
JENKINS_AGENT_PASSWORD=change-me-agent
# F´ checkout mounted read-only into Jenkins (default ../third_party/fprime)
# FPRIME_DIR=../third_party/fprime
# Agent side: oge agent run ... --ci-url $OGE_JENKINS_MCP_URL
# OGE_JENKINS_MCP_URL=http://127.0.0.1:8090/mcp-server/mcp
# OGE_JENKINS_USER=oge-agent
# OGE_JENKINS_TOKEN=<JENKINS_AGENT_PASSWORD or an API token of oge-agent>

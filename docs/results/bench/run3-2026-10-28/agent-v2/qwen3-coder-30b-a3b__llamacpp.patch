+void FprimeRouterTester::testContextTableFullAndNotFound() {
+    // Test the case where a buffer is not found in the context table on return
+    REQUIREMENT("SVC-ROUTER-009");
+    
+    // First, test the case where a buffer is returned that was never in the table
+    // This should emit BufferContextNotFound event and return with empty context
+    U8 data[1];

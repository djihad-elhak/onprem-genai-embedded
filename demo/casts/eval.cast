[17.423021, "o", "\u001b[36m \u001b[0m\u001b[1m                   \u001b[0m\u001b[36m \u001b[0m\u001b[1m                \u001b[0m\u001b[36m \u001b[0m\u001b[36mTest-gen pass@1 \u001b[0m\u001b[1m  \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mRefactor pass@1 \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[1m                \u001b[0m\u001b[36m \u001b[0m\u001b[1m        \u001b[0m\u001b[36m \u001b[0m\u001b[1m              \u001b[0m\u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m\u001b[36mModel\u001b[0m\u001b[1m             \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mGenerate pass@1\u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36m(mutation score)\u001b[0m\u001b[1m  \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36m(CCN↓)\u001b[0m\u001b[1m           \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mDocument pass@1\u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mOverall\u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mLatency / task\u001b[0m\u001b[36m \u001b[0m\r\n\u001b[36m ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────── \u001b[0m\r\n\u001b[36m \u001b[0mdevstral-small-2-… \u001b[36m \u001b[0m42%             \u001b[36m \u001b[0m17% (30%)          \u001b[36m \u001b[0m40% (48%)         \u001b[36m \u001b[0m50%             \u001b[36m \u001b[0m37%     \u001b[36m \u001b[0m100 s         \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0mqwen3-coder-30b-a… \u001b[36m \u001b[0m75%             \u001b[36m \u001b[0m0% (26%)           \u001b[36m \u001b[0m40% (54%)         \u001b[36m \u001b[0m100%            \u001b[36m \u001b[0m54%     \u001b[36m \u001b[0m23 s          \u001b[36m \u001b[0m\r\n\u001b[36m                                                                                                                      \u001b[0m\r\n"]

[21.047022, "o", "\u001b[96mvoid\u001b[0m\u001b[90m \u001b[0mComStubTester\u001b[90m \u001b[0m\u001b[92m::test_recovery_after_failure\u001b[0m()\u001b[90m \u001b[0m{\r\n\u001b[90m    \u001b[0mREQUIREMENT(\u001b[33m\"\u001b[0m\u001b[33mSVC-COMSTUB-007\u001b[0m\u001b[33m\"\u001b[0m);\r\n\u001b[90m    \u001b[0m\u001b[94mthis\u001b[0m->test_initial();\r\n\r\n\u001b[90m    \u001b[0m\u001b[2m// Simulate a failure scenario that sets m_reinitialize flag\u001b[0m\r\n\u001b[90m    \u001b[0mU8\u001b[90m \u001b[0mstorage[\u001b[94m8\u001b[0m];\r\n\u001b[90m    \u001b[0mFw::Buffer\u001b[90m \u001b[0mbuffer(storage,\u001b[90m \u001b[0m\u001b[94msizeof\u001b[0m(storage));\r\n\u001b[90m    \u001b[0mComCfg::FrameContext\u001b[90m \u001b[0mcontext;\r\n\r\n\u001b[90m    \u001b[0m\u001b[2m// Set up a send failure that will cause retry exhaustion\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mthis\u001b[0m->m_sync_send_status\u001b[90m \u001b[0m=\u001b[90m \u001b[0mDrv::ByteStreamStatus::SEND_RETRY;\r\n\u001b[90m    \u001b[0m\u001b[94mthis\u001b[0m->m_retry_fail\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[96mtrue\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// Ensure retries fail and exhaust\u001b[0m\r\n\r\n\u001b[90m    \u001b[0m\u001b[2m// Send data that will fail and set reinitialize flag\u001b[0m\r\n\u001b[90m    \u001b[0minvoke_to_dataIn(\u001b[94m0\u001b[0m,\u001b[90m \u001b[0mbuffer,\u001b[90m \u001b[0mcontext);\r\n\u001b[90m    \u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[2m// Verify that failure was reported\u001b[0m\r\n\u001b[90m    \u001b[0mASSERT_from_comStatusOut_SIZE(\u001b[94m1\u001b[0m);\r\n\u001b[90m    \u001b[0mASSERT_from_comStatusOut(\u001b[94m0\u001b[0m,\u001b[90m \u001b[0mFw::Success::FAILURE);\r\n\u001b[90m    \u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[2m// Clear history to isolate the recovery test\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mthis\u001b[0m->clearHistory();\r\n\u001b[90m    \u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[2m// Simulate driver reconnection (this should emit exactly one SUCCESS)\u001b[0m\r\n\u001b[90m    \u001b[0minvoke_to_drvConnected(\u001b[94m0\u001b[0m);\r\n\u001b[90m    \u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[2m// Verify exactly one SUCCESS was emitted for recovery\u001b[0m\r\n\u001b[90m    \u001b[0mASSERT_from_comStatusOut_SIZE(\u001b[94m1\u001b[0m);\r\n\u001b[90m    \u001b[0mASSERT_from_comStatusOut(\u001b[94m0\u001b[0m,\u001b[90m \u001b[0mFw::Success::SUCCESS);\r\n}\r\n"]

[11.576898, "o", "\u001b[2m    // Helper method implementations\u001b[0m\r\n\u001b[2m    void ComStub::handleSynchronousSend(Fw::Buffer& sendBuffer, const ComCfg::FrameContext& context) {\u001b[0m\r\n\u001b[2m        Drv::ByteStreamStatus sendStatus = Drv::ByteStreamStatus::SEND_RETRY;\u001b[0m\r\n\u001b[2m        Fw::Success comSuccess = Fw::Success::FAILURE;\u001b[0m\r\n"]
[11.577446, "o", "\u001b[1mDocChunk\u001b[0m Svc/ComStub/docs/sdd.md — 4.3.5 drvAsyncSendReturnIn  \u001b[2mSvc/ComStub/docs/sdd.md\u001b[0m\r\n"]
[11.578006, "o", "\u001b[2m    The `drvAsyncSendReturnIn` handler receives the send status and buffer ownership from an asynchronous dr\u001b[0m\r\n\u001b[2m    On `RETRY` status it resends the buffer on `drvAsyncSendOut` up to the retry limit; otherwise it returns\u001b[0m\r\n\u001b[2m    via `dataReturnOut` and reports success or failure on `comStatusOut`.\u001b[0m\r\n"]

[15.07393, "o", "\u001b[96mvoid\u001b[0m\u001b[90m \u001b[0m\u001b[92mComStubTester::test_req_sync_send_failure_reports_failure\u001b[0m()\u001b[90m \u001b[0m{\r\n\u001b[90m    \u001b[0mREQUIREMENT(\u001b[33m\"\u001b[0m\u001b[33mSVC-COMSTUB-003\u001b[0m\u001b[33m\"\u001b[0m);\r\n\u001b[90m    \u001b[0m\u001b[94mthis\u001b[0m->test_initial();\r\n\u001b[90m    \u001b[0mU8\u001b[90m \u001b[0mstorage[\u001b[94m8\u001b[0m];\r\n\u001b[90m    \u001b[0mFw::Buffer\u001b[90m \u001b[0mbuffer(storage,\u001b[90m \u001b[0m\u001b[94msizeof\u001b[0m(storage));\r\n\u001b[90m    \u001b[0m\u001b[94mthis\u001b[0m->fill(buffer);\r\n\u001b[90m    \u001b[0mComCfg::FrameContext\u001b[90m \u001b[0mcontext;\r\n\u001b[90m    \u001b[0m\u001b[94mthis\u001b[0m->m_sync_send_status\u001b[90m \u001b[0m=\u001b[90m \u001b[0mDrv::ByteStreamStatus::OTHER_ERROR;\r\n\u001b[90m    \u001b[0m\u001b[94mthis\u001b[0m->clearHistory();\r\n\u001b[90m    \u001b[0m\u001b[94mthis\u001b[0m->invoke_to_dataIn(\u001b[94m0\u001b[0m,\u001b[90m \u001b[0mbuffer,\u001b[90m \u001b[0mcontext);\r\n\u001b[90m    \u001b[0mASSERT_from_drvSendOut_SIZE(\u001b[94m1\u001b[0m);\r\n\u001b[90m    \u001b[0mASSERT_from_comStatusOut_SIZE(\u001b[94m1\u001b[0m);\r\n\u001b[90m    \u001b[0mASSERT_from_comStatusOut(\u001b[94m0\u001b[0m,\u001b[90m \u001b[0mFw::Success::FAILURE);\r\n}\r\n"]
